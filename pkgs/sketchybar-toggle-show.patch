Resolve sketchybar through PATH when it is not in a Homebrew prefix, and
show the bar with `hidden=off topmost=on` only: the animated y_offset leaves
item mouse tracking at the old position, and a menu bar reveal lifts
MenuBarAgent above the bar until topmost is set again.
diff --git a/Sources/SketchyBarToggleCore/PrerequisiteChecker.swift b/Sources/SketchyBarToggleCore/PrerequisiteChecker.swift
index 9708c07..46a6961 100644
--- a/Sources/SketchyBarToggleCore/PrerequisiteChecker.swift
+++ b/Sources/SketchyBarToggleCore/PrerequisiteChecker.swift
@@ -33,7 +33,10 @@ public final class PrerequisiteChecker {
         } else if FileManager.default.fileExists(atPath: "/usr/local/bin/sketchybar") {
             sketchybarPath = "/usr/local/bin/sketchybar"
         } else {
-            sketchybarPath = "sketchybar"
+            sketchybarPath = ProcessInfo.processInfo.environment["PATH"]?
+                .split(separator: ":")
+                .map { "\($0)/sketchybar" }
+                .first { FileManager.default.isExecutableFile(atPath: $0) } ?? "sketchybar"
         }
     }
 
